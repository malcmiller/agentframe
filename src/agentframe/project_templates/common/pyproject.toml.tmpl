[project]
name = "$project"
version = "0.1.0"
description = "$description"
requires-python = ">=3.13"
# Add the foundry extra to use a Microsoft Foundry deployment instead of Ollama.
dependencies = ["agentframe-py[server,ollama]$agentframe_range"]

[dependency-groups]
dev = [
    "mypy>=2.4.1",
    "pytest>=9.2.0",
    "pytest-asyncio>=1.5.0",
    "ruff>=0.17.5",
]

[tool.ruff]
line-length = 88
target-version = "py313"

[tool.ruff.lint]
select = ["E", "W", "F", "I", "B", "UP", "SIM", "N", "C4", "RUF"]

[tool.mypy]
python_version = "3.13"
strict = true
files = ["$package", "tests"]

[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["."]
asyncio_mode = "auto"
asyncio_default_fixture_loop_scope = "function"
addopts = ["--strict-markers", "--strict-config", "-ra"]
